# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası .gitignore'da; git'e ve GitHub'a asla girmez.

# Zorunlu
ANTHROPIC_API_KEY=buraya-anahtar

# Yalnızca sunucuda (docker compose). Parola ve anahtar uzun ve rastgele olsun:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# POSTGRES_PASSWORD=
# INTERNREADER_GIZLI_ANAHTAR=      # abonelikten çıkış bağlantılarını imzalar; değişirse eski bağlantılar geçersiz olur
# SITE_ALAN_ADI=internreader.dev   # Caddy bu alan adı için HTTPS sertifikasını kendisi alır

# Bülten e-postası (SMTP). SMTP_SUNUCU boşsa e-posta gönderilmez, cikti/giden_eposta/ klasörüne yazılır (deneme).
# Gönderen alan adı için DNS'te SPF, DKIM ve DMARC kayıtları kurulmadan gerçek gönderim yapma (spama düşer).
# SMTP_SUNUCU=smtp.saglayici.com
# SMTP_PORT=587                     # 587: STARTTLS · 465: doğrudan TLS
# SMTP_KULLANICI=
# SMTP_PAROLA=
# EPOSTA_KIMDEN=InternReader <bulten@alan-adiniz>
# EPOSTA_YANIT=                     # yanıtların gideceği adres (boşsa Reply-To eklenmez)

# İsteğe bağlı (varsayılanlar parantez içinde)
# INTERNREADER_YZ_TOPLU=1                  # (0) yapay zekâ işlerini Message Batches ile yarı fiyatına gönder;
#                                          #     sonuç birkaç dakika–1 saat sürebilir, 45 dk'da gelmezse normal yoldan
# INTERNREADER_YZ_TAVANI_USD=0.50          # bir çalıştırmada en fazla yapay zekâ harcaması ($)
# INTERNREADER_AYLIK_YZ_TAVANI_USD=2.00    # bir takvim ayında en fazla toplam harcama ($)
# INTERNREADER_MODEL=claude-haiku-5-5
# DATABASE_URL=sqlite:///veri/internreader.db
