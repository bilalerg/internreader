---
import Taban from "../layouts/Taban.astro";
import BolumBasligi from "../components/BolumBasligi.astro";
import TurkiyeRadari from "../components/TurkiyeRadari";
import BoruHatti from "../components/BoruHatti";
import DaginikKaynaklar from "../components/DaginikKaynaklar";
import SirketSeridi from "../components/SirketSeridi.astro";
import Bulten from "../components/Bulten";
import { turkiyeHaritasi } from "../veri/harita";
import { ilanlariOku, istatistikOku } from "../veri/yukle";
import { SEVIYE_ADI, sayi, tarihSaat } from "../veri/etiketler";

const istatistik = istatistikOku();
const liste = ilanlariOku();
const harita = turkiyeHaritasi(istatistik.sehirler);
const haritaOrnekleri = liste.ilanlar
  .filter((i) => i.sehirler.length > 0)
  .map((i) => ({
    baslik: i.baslik,
    firma: i.firma_gorunen,
    seviye: SEVIYE_ADI[i.seviye] ?? i.seviye,
    sehir: i.sehirler[0],
  }));

// Başlık kelime kelime yükselir (her kelime ayrı bir maskenin içinde)
const baslikSatir1 = "Staj ilanı aramayı bırak.".split(" ");
const baslikSatir2 = "Her sabah sana gelsin.".split(" ");

const faydalar = [
  {
    baslik: "Sadece sana uygun",
    metin: "Şehir, alan ve seviye seçersin. Senior ilanlar, satış, pazarlama ve idari işler sana hiç gelmez.",
  },
  { baslik: "Doğrudan şirketten", metin: "Her ilan şirketin kendi başvuru sayfasına gider. Aracı yok, ek form yok." },
  {
    baslik: "Uydurma ilan yok",
    metin: "Yapay zekânın bulduğu her başlık sayfada birebir aranır; sayfada yazmıyorsa listeye girmez.",
  },
  {
    baslik: "İlk gün haberin olur",
    metin: "İlan ilk görüldüğü sabah e-postanda. Aylardır açık eski ilanlar “yeni” diye gelmez.",
  },
  {
    baslik: "Öğrenciler için ücretsiz",
    metin: "Abonelik ücretsiz. Kodun tamamı açık; nasıl çalıştığını herkes görebilir.",
  },
  { baslik: "Verin sende", metin: "Yalnızca e-posta adresin ve tercihlerin saklanır. Çıktığın an adresin silinir." },
];

const sorular = [
  {
    soru: "Ücretli mi?",
    cevap: "Hayır. Bülten öğrenciler için ücretsiz. Kayıt için yalnızca e-posta adresi gerekir.",
  },
  {
    soru: "İlanlar nereden geliyor?",
    cevap:
      "Şirketlerin kendi kariyer sayfalarından ve herkese açık ilan sistemlerinden (Lever, Greenhouse, Ashby, Workable, Recruitee, SmartRecruiters, Breezy, Workday). LinkedIn, Kariyer.net gibi platformlardan veri çekilmez; sitelerin robots.txt kurallarına uyulur.",
  },
  {
    soru: "Yapay zekâ hata yapmaz mı?",
    cevap:
      "Yapabilir. Bu yüzden iki önlem var: bulunan her başlık sayfada birebir aranır (uydurma ilan giremez) ve her ilan şirketin kendi sayfasına gider. Başvurmadan önce ilanı orada okumanı öneririz. Hatalı bir ilan görürsen bildir, düzeltelim.",
  },
  {
    soru: "Hangi şehirler var?",
    cevap:
      "Türkiye'nin her yeri ve uzaktan çalışma. İlanların çoğu İstanbul ve Ankara'da; konumu yazmayan ilanlar da “konum belirtilmemiş” etiketiyle gelir.",
  },
  {
    soru: "Ne sıklıkla e-posta gelir?",
    cevap:
      "Seçimine göre her sabah 07:00'de ya da haftada bir. O gün sana uygun yeni ilan yoksa e-posta gelmez; aynı ilan iki kez gelmez.",
  },
  {
    soru: "E-posta adresim ne olacak?",
    cevap:
      "Yalnızca bülteni göndermek için kullanılır; satılmaz, kimseyle paylaşılmaz. Her e-postanın altındaki bağlantıyla tek tıkla çıkarsın ve adresin veritabanından silinir. Ayrıntılar KVKK aydınlatma metninde.",
  },
  {
    soru: "Şirketim listede yok, nasıl eklenir?",
    cevap:
      "Proje açık kaynak: GitHub sayfasından şirketin kariyer sayfasını bildirmen yeterli. Liste her ay yeni şirketlerle genişliyor.",
  },
];
---

<Taban>
  <!-- ================= GİRİŞ ================= -->
  <section class="mx-auto max-w-[1200px] px-5 pb-20 pt-12 md:px-8 md:pb-28 md:pt-20" data-giris>
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12">
      <div data-giris-metin>
        <p class="etiket flex flex-wrap items-center gap-x-3 gap-y-1">
          <span>Yazılım · Yapay zekâ · Veri stajları</span>
          <span aria-hidden="true">/</span>
          <span>Her sabah 07:00</span>
        </p>
        <h1
          class="baslik mt-6 text-[clamp(2.7rem,6.4vw,5.2rem)] font-[560]"
          aria-label="Staj ilanı aramayı bırak. Her sabah sana gelsin."
        >
          <span aria-hidden="true">
            {baslikSatir1.map((k, i) => (
              <>
                <span class="kelime">
                  <span style={`--i:${i}`}>{k}</span>
                </span>
                {i < baslikSatir1.length - 1 && " "}
              </>
            ))}
            <span class="mt-1 block font-[420] italic">
              <span class="fosfor" style="transition-delay: 1.15s">
                {baslikSatir2.map((k, i) => (
                  <>
                    <span class="kelime">
                      <span style={`--i:${i + baslikSatir1.length}`}>{k}</span>
                    </span>
                    {i < baslikSatir2.length - 1 && " "}
                  </>
                ))}
              </span>
            </span>
          </span>
        </h1>
        <p class="mt-7 max-w-[34rem] text-[1.12rem] leading-[1.65] text-murekkep-2">
          {`InternReader ${sayi(istatistik.takip_edilen_firma)} şirketi takip eder; her sabah ${sayi(istatistik.taranan_firma)} şirketin kariyer sayfasını ve ilan sistemini yapay zekâyla okur. Öğrenciye uygun `}
          <strong class="font-semibold text-murekkep">yazılım, yapay zekâ ve veri</strong>
          {" ilanlarını ayıklar; sana yalnızca seçtiğin şehir, alan ve seviyedekileri e-postayla gönderir."}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#bulten" class="dugme dugme-ana miknatis">
            Bültenimi oluştur
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M3 8h10m-4-4 4 4-4 4"
                stroke="currentColor"
                stroke-width="1.7"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
          <a href="#nasil" class="dugme dugme-ikincil miknatis">
            Nasıl çalışır?
          </a>
        </div>
        <p class="mt-6 font-mono text-[0.78rem] text-murekkep-3">
          Ücretsiz · Spam yok · Tek tıkla çıkış · Son tarama {tarihSaat(istatistik.guncelleme)}
        </p>
        <p class="mt-2 flex items-center gap-2.5 font-mono text-[0.78rem] text-murekkep-2">
          <span class="nabiz" aria-hidden="true"></span>
          <span data-sonraki-baski>Yeni baskı her sabah 07:00'de</span>
        </p>
      </div>

      <div data-giris-gorsel>
        <div class="giris-yuksel">
          <TurkiyeRadari
            client:visible
            harita={harita}
            ornekler={haritaOrnekleri}
            toplam={{ firma: istatistik.taranan_firma, ilan: istatistik.aktif_ilan, ogrenci: istatistik.ogrenci_ilani }}
            gun={tarihSaat(istatistik.guncelleme).split(",")[0]}
          />
        </div>
      </div>
    </div>
  </section>

  <SirketSeridi firmalar={istatistik.firmalar} taranan={istatistik.taranan_firma} />

  <!-- ================= SORUN ================= -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 md:px-8 md:py-24">
    <BolumBasligi no="01" etiket="Sorun">
      İyi stajlar ilan sitelerine düşmüyor.
    </BolumBasligi>
    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="space-y-5 text-[1.08rem] leading-[1.75] text-murekkep-2">
        <p class="baslik text-[clamp(1.45rem,2.2vw,1.85rem)] !leading-[1.3] text-murekkep" data-okunan>
          Teknoloji şirketlerinin ve girişimlerin çoğu stajyer ilanını yalnızca{" "}
          <span class="fosfor text-murekkep">kendi kariyer sayfasına</span> ya da Lever, Greenhouse, Workday gibi ilan
          sistemlerine koyar. Büyük platformlarda bu ilanların çoğu hiç görünmez.
        </p>
        <p>
          Hepsini takip etmek, yüzlerce sayfayı her gün tek tek açmak demek. Kimse bunu yapamıyor; bu yüzden iyi
          ilanlar, tesadüfen duyanlara kalıyor.
        </p>
        <p class="text-murekkep">
          InternReader bu sayfaları senin yerine her sabah okur ve sana uyanları tek bir e-postada toplar.
        </p>
      </div>

      <DaginikKaynaklar
        client:visible
        taranan={istatistik.taranan_firma}
        aktifIlan={istatistik.aktif_ilan}
        ogrenciIlani={istatistik.ogrenci_ilani}
      />
    </div>
  </section>

  <!-- ================= NASIL ÇALIŞIR ================= -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 md:px-8 md:py-24">
    <BolumBasligi no="02" etiket="Nasıl çalışır" id="nasil">
      Sen uyurken, her sabah dört adım.
    </BolumBasligi>
    <div class="mt-12">
      <BoruHatti
        client:visible
        firmalar={istatistik.firmalar}
        kararlar={istatistik.kararlar}
        taranan={istatistik.taranan_firma}
      />
    </div>
  </section>

  <!-- ================= BÜLTENİ DENE + ABONE OL ================= -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 md:px-8 md:py-24">
    <BolumBasligi no="03" etiket="Bülteni dene" id="bulten">
      Seçimini yap, yarın sabah ne geleceğini şimdi gör.
    </BolumBasligi>
    <p class="mt-6 max-w-2xl text-[1.08rem] leading-[1.7] text-murekkep-2">
      Sağdaki önizleme bu sabahki gerçek ilanlarla çalışıyor. Seçimlerini değiştir, gelecek e-posta da değişsin.
      Beğendiysen aynı tercihlerle abone ol.
    </p>
    <div class="mt-12">
      <Bulten client:visible ilanlar={liste.ilanlar} guncelleme={liste.guncelleme} />
    </div>
  </section>

  <!-- ================= NE SAĞLAR ================= -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 md:px-8 md:py-24">
    <BolumBasligi no="04" etiket="Ne sağlar">
      Daha az arama, daha çok başvuru.
    </BolumBasligi>
    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {faydalar.map((f, i) => (
        <li class="kart isik p-6 md:p-7" data-belir style={`--sira:${i % 3}`}>
          <span class="font-mono text-[0.75rem] text-murekkep-3">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="baslik mt-3 text-[1.6rem] font-[540]">{f.baslik}</h3>
          <p class="mt-3 leading-[1.7] text-murekkep-2">{f.metin}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ================= SSS ================= -->
  <section class="mx-auto max-w-[1200px] px-5 py-16 md:px-8 md:py-24">
    <BolumBasligi no="05" etiket="Sık sorulanlar" id="sss">
      Aklına takılanlar.
    </BolumBasligi>
    <div class="mt-12 divide-y divide-cizgi border-y border-cizgi">
      {sorular.map((s, i) => (
        <details class="group py-1" data-belir style={`--sira:${Math.min(i, 4)}`}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.12rem] font-medium [&::-webkit-details-marker]:hidden">
            {s.soru}
            <span
              class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-cizgi transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg width="12" height="12" viewBox="0 0 12 12">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <p class="max-w-3xl pb-6 leading-[1.75] text-murekkep-2">{s.cevap}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ================= KAPANIŞ ================= -->
  <section class="mx-auto max-w-[1200px] px-5 pt-10 md:px-8">
    <div class="kart isik egim relative overflow-hidden px-6 py-14 text-center md:px-12 md:py-20" data-egim="4">
      <p class="etiket">Yarın 07:00</p>
      <p class="baslik mx-auto mt-5 max-w-[18ch] text-[clamp(2.2rem,5vw,4rem)] font-[540]">
        İlk bültenin yarın sabah <span class="fosfor italic">gelsin.</span>
      </p>
      <a href="#bulten" class="dugme dugme-ana miknatis mt-9">
        Ücretsiz abone ol
      </a>
    </div>
  </section>
</Taban>
